<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-authored test fixture (not a real song): grand-staff Piano part with
     conflicting per-staff dynamics. Pins the cross-staff dynamics leak: the
     treble p at m.1 must not reach the bass, and the bass ff at m.2 must not
     reach the treble. -->
