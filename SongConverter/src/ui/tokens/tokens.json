{
  "color": {
    "$type": "color",
    "surface": {
      "page": { "$value": "#0a0a0a" },
      "raised": { "$value": "#1a1a1a" }
    },
    "border": {
      "subtle": { "$value": "#1e1e1e" },
      "default": { "$value": "#333333" }
    },
    "text": {
      "default": { "$value": "#ffffff" },
      "emphasis": { "$value": "#e8e8e8" },
      "secondary": { "$value": "#c8c8c8" },
      "muted": { "$value": "#8c8c8c" },
      "disabled": { "$value": "#666666" },
      "on-primary": { "$value": "#111111" },
      "link": { "$value": "#4d9fff" },
      "link-hover": { "$value": "#7db8ff" },
      "warning": { "$value": "#f0a824" }
    },
    "control": {
      "bg": { "$value": "#333333" },
      "bg-hover": { "$value": "#515151" },
      "bg-active": { "$value": "#7c7c7c" },
      "accent": { "$value": "#8b8b8b" }
    },
    "primary": {
      "bg": { "$value": "#dadada" },
      "bg-hover": { "$value": "#bebebe" },
      "bg-active": { "$value": "#9c9c9c" }
    },
    "focus": {
      "ring": { "$value": "{color.text.link}" }
    }
  },
  "size": {
    "$type": "dimension",
    "focus-ring-width": { "$value": 2 },
    "focus-ring-offset": { "$value": 2 },
    "radius": {
      "sm": { "$value": 6 },
      "md": { "$value": 8 },
      "pill": { "$value": 20 }
    },
    "font": {
      "xs": { "$value": 12 },
      "sm": { "$value": 13 },
      "md": { "$value": 14 },
      "lg": { "$value": 15 },
      "xl": { "$value": 20 }
    },
    "space": {
      "xs": { "$value": 4 },
      "sm": { "$value": 8 },
      "md": { "$value": 16 },
      "lg": { "$value": 24 }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  }
}
