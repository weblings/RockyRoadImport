{
  "name": "RockyRoadImport",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO_MODE=true npm run dev",
    "build": "npm run build:wasm && tsc && vite build",
    "build:demo": "cross-env VITE_DEMO_MODE=true npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "patch-package",
    "build:wasm": "dotnet build wasm/PsarcChartCore.Wasm -c Release && node scripts/copy-wasm.mjs",
    "deploy": "npm run build:demo && gh-pages -d dist",
    "prebuild": "npm run lint",
    "lint": "npm run lint:css && npm run lint:react-aria",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:react-aria": "node scripts/check-react-aria-imports.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.1.1",
    "jsdom": "30.1.3",
    "patch-package": "^8.0.1",
    "stylelint": "17.16.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "vitest-axe": "0.1.0"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "@weblings/grille": "github:weblings/GrilleDS#61e83a7c4e63fb20f1dcce2bf1b24d1347ea9151",
    "fflate": "^0.8.2",
    "midi-json-parser": "^8.1.73",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
