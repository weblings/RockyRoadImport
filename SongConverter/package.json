{
  "name": "RockyRoadImport",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO_MODE=true npm run dev",
    "build": "npm run build:wasm && tsc && vite build",
    "build:demo": "cross-env VITE_DEMO_MODE=true npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:wasm": "dotnet build wasm/PsarcChartCore.Wasm -c Release && node scripts/copy-wasm.mjs",
    "deploy": "npm run build:demo && gh-pages -d dist"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "gh-pages": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "fflate": "^0.8.2",
    "midi-json-parser": "^8.1.73"
  }
}
